--- a/libkern/c++/OSKext.cpp
+++ b/libkern/c++/OSKext.cpp
@@ -8215,6 +8215,7 @@
 	kern_return_t                       (* startfunc)(kmod_info_t *, void *);
 	unsigned int                        i, count;
 	void                              * kmodStartData = NULL;
+	bool                                skipStartfunc = false;
 
