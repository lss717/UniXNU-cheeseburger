 		result = kOSReturnSuccess;
@@ -8248,6 +8249,26 @@
 
 	startfunc = kmod_info->start;
 
+#if defined(XNU_SOURCE_CORECRYPTO14)
+	/*
+	 * The source-corecrypto bootstrap calls corecrypto_kext_start() very
+	 * early to install the kernel PRNG.  Starting the prelinked corecrypto
+	 * component a second time asserts !prng_ready; its dependencies only
